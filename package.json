{
  "name": "copilot-spy",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "node server/index.mjs",
    "dev": "node server/index.mjs",
    "build": "vite build",
    "test": "node scripts/run-tests.mjs",
    "connect": "node scripts/install-bridge.mjs",
    "disconnect": "node scripts/install-bridge.mjs --remove",
    "package": "node scripts/package.mjs",
    "verify:zip": "node scripts/verify-zip.mjs",
    "benchmark": "node --expose-gc scripts/benchmark.mjs",
    "test:e2e": "playwright test",
    "doctor": "node scripts/doctor.mjs",
    "test:memory": "node --expose-gc scripts/memory-soak.mjs",
    "test:cli": "node scripts/test-cli.mjs"
  },
  "dependencies": {
    "@xyflow/react": "^12.10.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "fflate": "^0.8.2",
    "vite": "^7.2.0"
  },
  "description": "Spy: a live React graph viewer for GitHub Copilot CLI agents"
}
